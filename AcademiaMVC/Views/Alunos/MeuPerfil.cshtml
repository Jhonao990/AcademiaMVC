
@model Aluno
@{ ViewData["Title"] = "Meu perfil"; }
<h1 class="page-title">Meu perfil</h1><p class="text-secondary">Preencha seus dados para solicitar matrículas.</p>
<form asp-action="MeuPerfil" class="form-panel">
 <div asp-validation-summary="All" class="text-danger"></div>
 <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" /><span asp-validation-for="Telefone" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="DataNascimento" class="form-label"></label><input asp-for="DataNascimento" class="form-control" /><span asp-validation-for="DataNascimento" class="text-danger"></span></div>
 <button class="btn btn-lime">Salvar perfil</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
