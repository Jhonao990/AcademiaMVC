@model Aluno
@{ ViewData["Title"] = "Excluir aluno"; }
<div class="form-panel"><h1 class="page-title">Excluir aluno</h1><p>Confirma a exclusão de <strong>@Model.Nome</strong>?</p><p class="text-danger">Alunos com histórico de matrículas não podem ser excluídos.</p><form asp-action="Delete"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Confirmar exclusão</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div>
