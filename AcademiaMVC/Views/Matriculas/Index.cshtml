
@model IEnumerable<Matricula>
@{ ViewData["Title"] = "Gerenciar matrículas"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="page-title">Matrículas</h1><a asp-action="Create" class="btn btn-lime">+ Nova matrícula</a></div>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Aluno</th><th>Modalidade</th><th>Data</th><th>Valor</th><th>Status</th><th>Ações</th></tr></thead><tbody>
@foreach(var m in Model) { <tr><td>@m.Aluno?.Nome</td><td>@m.Modalidade?.Nome</td><td>@m.DataMatricula.ToString("dd/MM/yyyy")</td><td>R$ @m.ValorMensal.ToString("N2")</td><td>@m.Status</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@m.Id">Detalhes</a> · <a asp-action="Edit" asp-route-id="@m.Id">Editar</a> · <a asp-action="Delete" asp-route-id="@m.Id">Excluir</a></td></tr> }
</tbody></table></div>
