@model Matricula
@{ ViewData["Title"] = "Detalhes da matrícula"; }
<div class="form-panel"><h1 class="page-title">Matrícula #@Model.Id</h1><p><strong>Aluno:</strong> @Model.Aluno?.Nome</p><p><strong>Modalidade:</strong> @Model.Modalidade?.Nome</p><p><strong>Data:</strong> @Model.DataMatricula.ToString("dd/MM/yyyy")</p><p><strong>Valor:</strong> R$ @Model.ValorMensal.ToString("N2")</p><p><strong>Status:</strong> @Model.Status</p><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
