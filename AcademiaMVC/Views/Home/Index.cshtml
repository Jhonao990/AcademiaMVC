
@{
 ViewData["Title"] = "Início";
}
<section class="hero rounded-4 p-4 p-lg-5 mb-5">
 <div class="row align-items-center">
  <div class="col-lg-7">
   <span class="eyebrow">MOVIMENTO • SAÚDE • CONSTÂNCIA</span>
   <h1 class="display-3 fw-bold mt-3">Treine do seu jeito.</h1>
   <p class="lead text-secondary mt-3">Encontre sua modalidade, confira as vagas disponíveis e solicite sua matrícula na Ritmo Academia.</p>
   <a class="btn btn-lime btn-lg mt-3" asp-controller="Modalidades" asp-action="Index">Explorar modalidades</a>
  </div>
  <div class="col-lg-5 mt-4 mt-lg-0"><img class="img-fluid rounded-4 hero-img" src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1100" alt="Academia com equipamentos de musculação" /></div>
 </div>
</section>
<div class="row g-3">
 <div class="col-md-4"><div class="info-card"><div class="info-number">01</div><h3>Escolha</h3><p>Consulte modalidades, horários, valores e vagas.</p></div></div>
 <div class="col-md-4"><div class="info-card"><div class="info-number">02</div><h3>Matricule-se</h3><p>Entre na sua conta, complete seu perfil e solicite a matrícula.</p></div></div>
 <div class="col-md-4"><div class="info-card"><div class="info-number">03</div><h3>Acompanhe</h3><p>Consulte suas matrículas e acompanhe o status.</p></div></div>
</div>
